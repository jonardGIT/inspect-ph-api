{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist-test",
    "types": ["node", "jest"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/__tests__/**/*.ts",
    "jest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "prisma", "docs"]
}
