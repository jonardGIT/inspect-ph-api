generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                 @id @default(uuid())
  email                     String                 @unique
  name                      String
  passwordHash              String
  role                      UserRole               @default(INSPECTOR)
  expoPushToken             String?
  failedLoginAttempts       Int                    @default(0)
  lockedUntil               DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  lguId                     String?
  businessId                String?
  auditLogs                 AuditLog[]
  authSessions              AuthSession[]
  assignedInspections       Inspection[]           @relation("InspectionInspector")
  notificationOutboxEntries NotificationOutbox[]
  createdPermitRecords      PermitRecord[]         @relation("PermitRecordCreator")
  ownedIssueReports         IssueReport[]          @relation("IssueReportReporter")
  lgu                       Lgu?                   @relation(fields: [lguId], references: [id])
  business                  BusinessEstablishment? @relation("BusinessOwner", fields: [businessId], references: [id])
  officeAssignments         UserOfficeAssignment[]
  submittedDisputes         FindingDispute[]       @relation("DisputeSubmitter")
  resolvedDisputes          FindingDispute[]       @relation("DisputeResolver")
  dataSubjectRequests       DataSubjectRequest[]
  resolvedAnomalyFlags      PaymentAnomalyFlag[]
  oauthAuthCodes            OAuthAuthorizationCode[]
  oauthAccessTokens         OAuthAccessToken[]
  requestedRecognitions     CrossLguRecognitionRequest[] @relation("RecognitionRequester")
  consentedRecognitions     CrossLguRecognitionRequest[] @relation("RecognitionConsentOwner")
  resolvedRecognitions      CrossLguRecognitionRequest[] @relation("RecognitionResolver")
  nationalVerifications     NationalVerificationRecord[] @relation("VerificationRequester")

  @@index([lguId])
  @@index([businessId])
}

model Lgu {
  id               String                 @id @default(uuid())
  code             String                 @unique
  name             String
  region           String?
  province         String?
  city             String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  archivedAt       DateTime?
  offices               Office[]
  users                 User[]
  webhookEndpoints             LguWebhookEndpoint[]
  checklistTemplates           ChecklistTemplate[]
  templateRatings              ChecklistTemplateRating[]
  outgoingRecognitionRequests  CrossLguRecognitionRequest[] @relation("RecognitionRequesterLgu")
  incomingRecognitionRequests  CrossLguRecognitionRequest[] @relation("RecognitionIssuerLgu")

  @@index([name])
  @@index([region, province, city])
  @@index([archivedAt])
}

model Office {
  id                String                 @id @default(uuid())
  lguId             String
  code              String
  name              String
  description       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  inspections       Inspection[]
  lgu               Lgu                    @relation(fields: [lguId], references: [id], onDelete: Cascade)
  moduleAssignments OfficeModule[]
  userAssignments   UserOfficeAssignment[]

  @@unique([lguId, code])
  @@index([lguId])
  @@index([name])
  @@index([archivedAt])
}

model UserOfficeAssignment {
  id        String   @id @default(uuid())
  userId    String
  officeId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, officeId])
  @@index([userId])
  @@index([officeId])
}

model Module {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  description       String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  archivedAt        DateTime?
  officeAssignments OfficeModule[]

  @@index([name])
  @@index([isActive])
  @@index([archivedAt])
}

model OfficeModule {
  id        String   @id @default(uuid())
  officeId  String
  moduleId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, moduleId])
  @@index([officeId])
  @@index([moduleId])
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorRole   UserRole?
  action      String
  entityType  String
  entityId    String?
  summary     String
  detail      String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model NotificationOutbox {
  id              String                   @id @default(uuid())
  recipientUserId String
  channel         NotificationChannel      @default(IN_APP)
  eventType       String
  title           String
  body            String
  entityType      String?
  entityId        String?
  status          NotificationOutboxStatus @default(PENDING)
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  recipient       User                     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model BusinessEstablishment {
  id                      String         @id @default(uuid())
  businessName            String
  tradeName               String?
  ownerName               String
  taxIdentificationNumber String?
  addressLine             String
  barangay                String
  city                    String
  province                String
  contactNumber           String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  archivedAt              DateTime?
  inspections             Inspection[]
  ownerUsers              User[]         @relation("BusinessOwner")
  permitRecords           PermitRecord[]
  caps                    CorrectiveActionPlan[]
  nationalVerifications   NationalVerificationRecord[]

  @@index([businessName])
  @@index([barangay, city])
  @@index([archivedAt])
}

model PermitRecord {
  id              String                @id @default(uuid())
  businessId      String
  permitNumber    String                @unique
  applicationDate DateTime
  expirationDate  DateTime
  lineOfBusiness  String
  status          PermitStatus          @default(PENDING_INSPECTION)
  createdById     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  archivedAt      DateTime?
  inspections     Inspection[]
  payments        PaymentRecord[]
  business        BusinessEstablishment @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("PermitRecordCreator", fields: [createdById], references: [id])

  @@index([businessId])
  @@index([createdById])
  @@index([status])
  @@index([expirationDate])
  @@index([archivedAt])
}

model Inspection {
  id                     String                      @id @default(uuid())
  businessId             String
  permitRecordId         String
  officeId               String
  inspectorId            String?
  moduleCode             String?
  scheduledAt            DateTime
  startedAt              DateTime?
  completedAt            DateTime?
  status                 InspectionStatus            @default(SCHEDULED)
  notes                  String?
  locationLatitude       Float?
  locationLongitude      Float?
  locationAccuracyMeters Float?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  attachments            Attachment[]
  fireSafetyCertificate  FireSafetyCertificate?
  findings               Finding[]
  business               BusinessEstablishment       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inspector              User?                       @relation("InspectionInspector", fields: [inspectorId], references: [id])
  office                 Office                      @relation(fields: [officeId], references: [id], onDelete: Restrict)
  permitRecord           PermitRecord                @relation(fields: [permitRecordId], references: [id], onDelete: Cascade)
  checklistResults       InspectionChecklistResult[]
  caps                   CorrectiveActionPlan[]

  @@index([businessId])
  @@index([permitRecordId])
  @@index([officeId])
  @@index([inspectorId])
  @@index([moduleCode])
  @@index([status, scheduledAt])
}

model FireSafetyCertificate {
  id                String                      @id @default(uuid())
  inspectionId      String                      @unique
  certificateNumber String                      @unique
  issuedAt          DateTime
  expiresAt         DateTime
  status            FireSafetyCertificateStatus @default(DRAFT)
  remarks           String?
  verificationUrl   String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  inspection        Inspection                  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([issuedAt])
  @@index([expiresAt])
}

model IssueReport {
  id                     String              @id @default(uuid())
  reportNumber           String              @unique
  reporterUserId         String?
  category               IssueReportCategory
  subject                String
  description            String
  locationDescription    String?
  reporterName           String?
  reporterEmail          String?
  reporterPhone          String?
  locationLatitude       Float?
  locationLongitude      Float?
  locationAccuracyMeters Float?
  status                 IssueReportStatus   @default(SUBMITTED)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  reporterUser           User?               @relation("IssueReportReporter", fields: [reporterUserId], references: [id])

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([reporterUserId])
}

model PaymentRecord {
  id                String          @id @default(uuid())
  permitRecordId    String
  referenceNumber   String          @unique
  provider          PaymentProvider @default(LOCAL)
  providerPaymentId String?         @unique
  amountInMinor     Int
  currency          String          @default("PHP")
  status            PaymentStatus   @default(PENDING)
  description       String?
  checkoutUrl       String?
  paidAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  receiptNumber     String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  permitRecord      PermitRecord    @relation(fields: [permitRecordId], references: [id], onDelete: Cascade)
  anomalyFlags      PaymentAnomalyFlag[]

  @@index([permitRecordId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

model ChecklistTemplate {
  id             String                      @id @default(uuid())
  module         String
  code           String                      @unique
  title          String
  description    String?
  sortOrder      Int                         @default(0)
  isActive       Boolean                     @default(true)
  version        Int                         @default(1)
  lguId          String?
  forkedFromId   String?
  isMarketplace  Boolean                     @default(false)
  publishedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  results        InspectionChecklistResult[]
  ratings        ChecklistTemplateRating[]
  lgu            Lgu?                        @relation(fields: [lguId], references: [id])
  forkedFrom     ChecklistTemplate?          @relation("TemplateForked", fields: [forkedFromId], references: [id])
  forks          ChecklistTemplate[]         @relation("TemplateForked")

  @@index([module, isActive])
  @@index([lguId])
  @@index([isMarketplace])
}

model InspectionChecklistResult {
  id               String                @id @default(uuid())
  inspectionId     String
  templateId       String
  status           ChecklistResultStatus
  remarks          String?
  templateVersion  Int?
  templateSnapshot Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  findings         Finding[]
  inspection       Inspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  template         ChecklistTemplate     @relation(fields: [templateId], references: [id])

  @@unique([inspectionId, templateId])
  @@index([templateId])
  @@index([status])
}

model CorrectiveActionPlan {
  id           String                @id @default(uuid())
  findingId    String                @unique
  inspectionId String
  businessId   String
  description  String
  deadlineAt   DateTime?
  status       CapStatus             @default(OPEN)
  responseNote String?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  finding      Finding               @relation(fields: [findingId], references: [id], onDelete: Cascade)
  inspection   Inspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  business     BusinessEstablishment @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([businessId])
  @@index([status])
  @@index([deadlineAt])
}

model Finding {
  id                     String                     @id @default(uuid())
  inspectionId           String
  checklistResultId      String?
  severity               FindingSeverity
  title                  String
  description            String
  correctiveAction       String?
  dueDate                DateTime?
  resolvedAt             DateTime?
  locationLatitude       Float?
  locationLongitude      Float?
  locationAccuracyMeters Float?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  attachments            Attachment[]
  cap                    CorrectiveActionPlan?
  dispute                FindingDispute?
  checklistResult        InspectionChecklistResult? @relation(fields: [checklistResultId], references: [id])
  inspection             Inspection                 @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([checklistResultId])
  @@index([severity])
}

model FindingDispute {
  id               String               @id @default(uuid())
  findingId        String               @unique
  disputedByUserId String
  reason           String
  status           FindingDisputeStatus @default(PENDING)
  resolution       String?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  finding          Finding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  disputedBy       User                 @relation("DisputeSubmitter", fields: [disputedByUserId], references: [id])
  resolvedBy       User?                @relation("DisputeResolver", fields: [resolvedByUserId], references: [id])

  @@index([findingId])
  @@index([status])
  @@index([disputedByUserId])
}

model DataSubjectRequest {
  id                String                    @id @default(uuid())
  type              DataSubjectRequestType
  status            DataSubjectRequestStatus  @default(PENDING)
  requestedByUserId String?
  email             String
  description       String
  response          String?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  requestedBy       User?                     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestedByUserId])
  @@index([createdAt])
}

model Attachment {
  id                     String     @id @default(uuid())
  inspectionId           String
  findingId              String?
  fileName               String
  mimeType               String
  fileSizeBytes          Int
  storageKey             String     @unique
  capturedAt             DateTime?
  locationLatitude       Float?
  locationLongitude      Float?
  locationAccuracyMeters Float?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  finding                Finding?   @relation(fields: [findingId], references: [id])
  inspection             Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([findingId])
  @@index([capturedAt])
}

enum UserRole {
  ADMIN
  INSPECTOR
  LGU_ADMIN
  OFFICE_SUPERVISOR
  OFFICE_CLERK
  BUSINESS_OWNER
  CITIZEN
}

enum PermitStatus {
  DRAFT
  PENDING_INSPECTION
  APPROVED
  REJECTED
  EXPIRED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELED
}

enum ChecklistResultStatus {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentProvider {
  LOCAL
  PAYMONGO
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum FireSafetyCertificateStatus {
  DRAFT
  ISSUED
  REVOKED
  EXPIRED
}

enum IssueReportCategory {
  FIRE_HAZARD
  SANITATION
  STRUCTURAL
  PUBLIC_SAFETY
  OTHER
}

enum IssueReportStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum FindingDisputeStatus {
  PENDING
  REVIEWING
  UPHELD
  OVERTURNED
}

enum NotificationChannel {
  IN_APP
  PUSH
}

enum CapStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  source      String   @default("paymongo")
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model PaymentAnomalyFlag {
  id             String        @id @default(uuid())
  paymentId      String
  reason         String        // DUPLICATE | AMOUNT_MISMATCH | LOW_AMOUNT | HIGH_VELOCITY
  detail         String?
  quarantinedAt  DateTime      @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  payment        PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  resolvedBy     User?         @relation(fields: [resolvedById], references: [id])

  @@index([paymentId])
  @@index([resolvedAt])
  @@index([quarantinedAt])
}

model ChecklistTemplateRating {
  id         String            @id @default(uuid())
  templateId String
  lguId      String
  rating     Int               // 1–5
  comment    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  lgu        Lgu               @relation(fields: [lguId], references: [id], onDelete: Cascade)

  @@unique([templateId, lguId])
  @@index([templateId])
  @@index([lguId])
}

model LguWebhookEndpoint {
  id         String            @id @default(uuid())
  lguId      String
  url        String
  secret     String
  events     String[]
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  lgu        Lgu               @relation(fields: [lguId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([lguId])
  @@index([isActive])
}

model WebhookDelivery {
  id          String             @id @default(uuid())
  endpointId  String
  event       String
  payload     Json
  statusCode  Int?
  attempt     Int                @default(1)
  success     Boolean            @default(false)
  sentAt      DateTime           @default(now())
  nextRetryAt DateTime?
  endpoint    LguWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([success])
  @@index([nextRetryAt])
}

// ---------------------------------------------------------------------------
// OAuth2 third-party app authorization
// ---------------------------------------------------------------------------

model OAuthClient {
  id           String                   @id @default(uuid())
  clientId     String                   @unique
  clientSecret String                   // bcrypt-hashed
  name         String
  description  String?
  redirectUri  String
  scopes       String[]
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  authCodes    OAuthAuthorizationCode[]
  accessTokens OAuthAccessToken[]

  @@index([clientId])
}

model OAuthAuthorizationCode {
  id          String      @id @default(uuid())
  code        String      @unique
  clientId    String
  userId      String
  scope       String[]
  redirectUri String
  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([clientId])
  @@index([userId])
}

model OAuthAccessToken {
  id        String      @id @default(uuid())
  token     String      @unique
  clientId  String
  userId    String
  scope     String[]
  expiresAt DateTime
  createdAt DateTime    @default(now())
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([clientId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Cross-LGU mutual recognition
// ---------------------------------------------------------------------------

model CrossLguRecognitionRequest {
  id                String                    @id @default(uuid())
  requestingLguId   String
  issuingLguId      String?
  certificateNumber String
  businessName      String
  status            CrossLguRecognitionStatus @default(PENDING_CONSENT)
  requestedByUserId String?
  consentOwnerId    String?
  complianceScore   Int?
  complianceGrade   String?
  signedPayload     String?
  signature         String?
  consentGivenAt    DateTime?
  resolvedAt        DateTime?
  resolvedByUserId  String?
  expiresAt         DateTime
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  requestingLgu     Lgu                       @relation("RecognitionRequesterLgu", fields: [requestingLguId], references: [id])
  issuingLgu        Lgu?                      @relation("RecognitionIssuerLgu", fields: [issuingLguId], references: [id])
  requestedByUser   User?                     @relation("RecognitionRequester", fields: [requestedByUserId], references: [id])
  consentOwner      User?                     @relation("RecognitionConsentOwner", fields: [consentOwnerId], references: [id])
  resolvedByUser    User?                     @relation("RecognitionResolver", fields: [resolvedByUserId], references: [id])

  @@index([requestingLguId])
  @@index([issuingLguId])
  @@index([certificateNumber])
  @@index([status])
  @@index([consentOwnerId])
}

enum CrossLguRecognitionStatus {
  PENDING_CONSENT
  CONSENT_GRANTED
  APPROVED
  REJECTED
  EXPIRED
}

// ---------------------------------------------------------------------------
// National integrations — verification cache
// ---------------------------------------------------------------------------

model NationalVerificationRecord {
  id                String                   @id @default(uuid())
  kind              NationalVerificationKind
  referenceValue    String
  businessId        String?
  requestedByUserId String?
  result            Json
  verified          Boolean
  providerSource    String
  expiresAt         DateTime?
  createdAt         DateTime                 @default(now())
  business          BusinessEstablishment?   @relation(fields: [businessId], references: [id])
  requestedByUser   User?                    @relation("VerificationRequester", fields: [requestedByUserId], references: [id])

  @@index([kind, referenceValue])
  @@index([businessId])
  @@index([requestedByUserId])
  @@index([createdAt])
}

enum NationalVerificationKind {
  PCN
  TIN
  DTI_NAME
  SEC_NAME
  LRA_PARCEL
  DISASTER_ALERT
}

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  ERASURE
}

enum DataSubjectRequestStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
  WITHDRAWN
}
